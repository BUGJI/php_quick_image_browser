# ============================================
# 图片浏览器环境配置模板
# 复制本文件为 .env 并填写真实值
# .env 含敏感信息，切勿提交到版本库 / 公开分享
# ============================================

# --- 原图 WebDAV 代理 (serve_original.php) ---
# 远程 WebDAV 服务器地址（图片素材根目录）
WEBDAV_BASE_URL=https://example.com:443/你的目录/图片素材
# WebDAV 用户名
WEBDAV_USERNAME=your_username
# WebDAV 密码
WEBDAV_PASSWORD=your_password

# --- Admin 面板 (admin.php) ---
# 访问 http://你的地址/admin.php 的管理口令，请改成强随机值
ADMIN_TOKEN=change_me_to_a_long_random_string

# --- WebDAV 同步任务 (sync_webdav.php) ---
# 以下均为可选项；留空则用内置默认值。
# 优先级：admin 面板保存的 .sync_config.json > 这里的值 > 内置默认
# 白名单扩展名（逗号分隔，小写）
SYNC_WHITELIST=png,jpg,jpeg,webp,gif,md,txt
# 黑名单目录/文件（逗号分隔）
SYNC_BLACKLIST=.seekMeta,.seekTrash,@eaDir,#recycle,.thumbnails,Thumbs.db,.DS_Store
# 压缩质量 1-100（越小体积越小，画质越低）
SYNC_QUALITY=30
# 压缩后最大宽度 px（超出则等比缩放，0 或过小会被钳制到 >=16）
SYNC_MAX_WIDTH=300
# 每批处理的文件数（前端轮询模式；CLI 模式忽略）
SYNC_BATCH_SIZE=50

# --- AI 语义搜索 (ai_vector.php) ---
# 开关：true/false
AI_SEARCH_ENABLED=true
# 向量服务地址（fn-ai-model；本机直连用 127.0.0.1，云端通过 FRP 映射后填映射地址）
AI_BASE_URL=http://127.0.0.1:46091
# 向量服务 API Key（服务开启认证时必填；Bearer 方式）
AI_API_KEY=sk-xxxx
# 图片向量输入模式：path=NAS 本地路径(最省) / url=图片URL / base64=图片内容
AI_IMAGE_MODE=path
# NAS 上原图根目录绝对路径（与 WebDAV 图片素材对应，path 模式拼接用）
AI_IMAGE_ROOT=/volX/1000/Resources/share/图片素材
# 向量维度（fn-img2vec/fn-txt2vec 固定 1024，做成可配置以兼容其他服务）
AI_DIM=1024
# 参与向量化的扩展名（逗号分隔，小写；默认 png,jpg,jpeg,webp,gif）
AI_IMAGE_EXTS=png,jpg,jpeg,webp,gif
# 向量存储：json=本地 JSON 文件(测试/单机) / mysql=MySQL(生产，云端)
AI_STORAGE=json
# JSON 模式存储文件（相对项目根）
AI_VECTOR_FILE=.ai_vectors.json
# MySQL 模式连接（生产用；json 模式忽略）
AI_MYSQL_HOST=
AI_MYSQL_PORT=3306
AI_MYSQL_DB=
AI_MYSQL_USER=
AI_MYSQL_PASS=
# 每批处理的图片数（前端轮询模式；CLI 模式忽略）
AI_BATCH_SIZE=10

# --- AI 分类 (左侧 AI分类 文件夹) ---
# 模式：off=不启用(不显示AI分类) / realtime=实时计算(点击时对全库算topK) / cache=预生成分类索引(推荐,快)
AI_CLASSIFY_MODE=cache
# 每类最多返回图片数
AI_CLASSIFY_TOP=200
# 相似度阈值(0-1,低于则不算该分类,0=不限制)
AI_CLASSIFY_MIN_SCORE=0

